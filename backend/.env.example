# MongoDB Atlas (M0 Free Tier)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/healthcare_db?retryWrites=true&w=majority
DB_NAME=healthcare_db

# JWT Authentication
JWT_SECRET=your-256-bit-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Groq LLM (Free API from console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# Gmail SMTP Email Notifications (Free)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Calendar OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200

# Server Config
HOST=0.0.0.0
PORT=8000
